# Copy to .env and fill in what you need. Everything is optional for local testing.

PORT=4000

# 64 hex chars (32 bytes). Encrypts exact property locations and KYC ID numbers.
# If unset, a dev key is generated in data/app-secret.key. ALWAYS set this in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# --- Payments (Razorpay). Leave empty to use the built-in test checkout. ---
# Use Test Mode keys (rzp_test_...) from Razorpay Dashboard → Account & Settings → API Keys first.
# Prices: Single Unlock ₹29, District Pass ₹99 (40 unlocks in one district, 30 days). Unlocks last 6 months.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook URL: https://<your-server>/webhooks/razorpay  (events: payment.captured, payment.failed)
RAZORPAY_WEBHOOK_SECRET=

# --- Email OTP (any SMTP, e.g. Gmail with an App Password). Empty = code printed in console + shown in app. ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- SMS OTP (Twilio). Empty = code printed in console + shown in app. ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Admin account(s) — can approve/reject "wrong details" refunds and restore hidden listings.
# New reports are emailed here when SMTP is configured (otherwise printed in the server console).
ADMIN_EMAILS=

# Show OTP codes in the app when no email/SMS provider is configured (development only).
DEV_SHOW_OTP=true
# Auto-approve owner KYC (development). Set false in production and review KYC manually.
AUTO_APPROVE_KYC=true
# Add demo owners + listings on first start.
SEED_DEMO=true
BOOKING_HOLD_MINUTES=10

# "Continue with Google": OAuth client ID(s) whose ID tokens are accepted — the WEB client ID that the
# app passes as EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID (comma-separated if more than one). Empty = Google sign-in off.
GOOGLE_CLIENT_IDS=
