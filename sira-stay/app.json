{
  "expo": {
    "name": "Sira Stay",
    "slug": "sira-stay",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sirastay",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "in.sirastay.app"
    },
    "android": {
      "package": "in.sirastay.app",
      "adaptiveIcon": {
        "backgroundColor": "#E7F5F1",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E7C66",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sira Stay uses your location to show rentals near you and to help owners pin their property."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sira Stay needs access to your photos so you can upload property and ID photos.",
          "cameraPermission": "Sira Stay uses the camera so you can take property and ID photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
